{
  "name": "@local/beeapi-dashboard",
  "version": "1.2.8",
  "private": true,
  "type": "module",
  "description": "Query BeeAPI account balance in a native DSH panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "oauth.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "channels.js",
    "rate.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
